{
  "name": "project-ledger",
  "version": "1.0.0",
  "description": "A local-first, white-label project pipeline with deadline and payment tracking.",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup": "prisma generate && prisma db push && prisma db seed",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:demo": "prisma db seed -- --demo",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "prisma": "^6.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "com.projectledger.app",
    "productName": "Project Ledger",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      ".next/**/*",
      "!node_modules/**/*.md",
      "!src/**/*",
      "!.next/cache/**/*",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "prisma/prod.db",
        "to": "prisma/prod.db"
      },
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
